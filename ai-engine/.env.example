# EarningWhisperer AI Engine v9.5.9
# Copy to `.env` and replace placeholders.

# Credentials
OPENAI_API_KEY=
GEMINI_API_KEY=
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/earningwhisperer
DATABASE_CONNECT_TIMEOUT_SECONDS=2
DATABASE_FAILURE_COOLDOWN_SECONDS=15
DB_SCHEMA_PATH=sql/ai_engine_event_store_schema.sql

# Fast-route models
OPENAI_MODEL_FAST=gpt-5-mini
GEMINI_MODEL_FAST=gemini-3.1-flash-lite

# Primary / review routing
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.1-pro-preview
GEMINI_REVIEW_MODEL_CANDIDATES=gemini-3.1-pro-preview,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-pro
ENABLE_REVIEW_PASS=true
GEMINI_PRIMARY_MAX_OUTPUT_TOKENS=384
GEMINI_STANDARD_MAX_OUTPUT_TOKENS=640
GEMINI_REVIEW_MAX_OUTPUT_TOKENS=960
GEMINI_PRIMARY_THINKING_LEVEL=minimal
GEMINI_STANDARD_THINKING_LEVEL=low
GEMINI_REVIEW_THINKING_LEVEL=medium
GEMINI_MAX_TOKENS=2048
GEMINI_MAX_RETRIES=3
GEMINI_BASE_RETRY_DELAY=1.5
GEMINI_CONSENSUS_SAMPLES=3
GEMINI_CONSENSUS_MIN_CONFIDENCE=0.78
GEMINI_CONSENSUS_DISAGREEMENT_THRESHOLD=0.35

# LLM router
LLM_ROUTER_MAX_CALLS_PER_CHUNK=2
LLM_ROUTER_NOVELTY_THRESHOLD=0.18
LLM_ROUTER_HIGH_SIGNAL_RAW_THRESHOLD=0.45
LLM_ROUTER_HIGH_PRIORITY=8
LLM_ROUTER_REVIEW_CONFIDENCE_THRESHOLD=0.68

# Phase-1 scorer
PHASE1_PROVIDER=finbert
PHASE1_FINBERT_MODEL_NAME=ProsusAI/finbert
PHASE1_FINBERT_DEVICE=auto
PHASE1_FINBERT_MAX_LENGTH=256
PHASE1_MAX_CHARS=3000
PHASE1_CACHE_SIZE=1024
PHASE1_WARMUP_ON_STARTUP=true

# Thresholds
COMPOSITE_THRESHOLD=0.45
CONFIDENCE_THRESHOLD=0.70
RAW_SCORE_THRESHOLD=0.35
MAX_EUPHEMISM_COUNT=3
MIN_VOLUME_RATIO=1.50
MAX_VIX=28.0
KELLY_MAX_POSITION=0.12
EXECUTION_TARGET_WIN_RATE=0.50
BACKTEST_ROUND_TRIP_COST_PCT=0.30
SLIPPAGE_BPS_DEFAULT=8.0

# Composite / strategy weights
W_SENTIMENT=0.28
W_SUE=0.22
W_MOMENTUM=0.18
W_VOLUME=0.10
W_GAP=0.08
W_REVERSAL=0.08
W_SHORT_INTEREST=0.06

# Redis channels
REDIS_CHANNEL=trading-signals
REDIS_ENRICHED_CHANNEL=trading-signals-enriched
LEGACY_REDIS_PUBLISH_ENABLED=true
REDIS_ENRICHED_PUBLISH_ENABLED=true
REDIS_BACKUP_QUEUE_SIZE=100
REDIS_RECONNECT_DELAY=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Notifications
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_TIER=free
NOTIFICATION_FREE_DELAY_SECONDS=300

# Scorecard
SCORECARD_ENABLED=true
SCORECARD_STORE_PATH=data/scorecard.json

# Portfolio / KIS
PORTFOLIO_STORE_PATH=data/portfolio_snapshot.json
PORTFOLIO_INTRADAY_REFRESH_ENABLED=false
PORTFOLIO_INTRADAY_REFRESH_INTERVAL_MINUTES=10
PORTFOLIO_KIS_MOCK_PAYLOAD_PATH=
PORTFOLIO_KIS_POSITIONS_URL=
KIS_ACCOUNT_NUMBER=
KIS_APP_KEY=
KIS_APP_SECRET=

# Options advisor
OPTIONS_ADVISOR_ENABLED=true
OPTIONS_IV_RANK_HIGH_THRESHOLD=60.0
OPTIONS_IV_RANK_LOW_THRESHOLD=30.0

# MDD circuit breaker
MDD_CIRCUIT_BREAKER_ENABLED=true
MDD_WARNING_THRESHOLD=-0.10
MDD_PAUSE_THRESHOLD=-0.15
MDD_LIQUIDATE_THRESHOLD=-0.25
MDD_RECOVERY_GRACE_DAYS=3

# Signal quality filters
EVASION_SCORE_MAX=0.40
PROSODY_MIN_CONFIDENCE=0.55
CALL_QUALITY_MIN_SCORE=0.45

# yfinance adapter
YFINANCE_TIMEOUT_SECONDS=10.0
YFINANCE_REPAIR_ENABLED=true
YFINANCE_AUTO_ADJUST=false
YFINANCE_CACHE_TTL_SECONDS=300
YFINANCE_NEWS_LIMIT=8

# AlphaVantage fallback
ALPHAVANTAGE_API_KEY=demo

# RAG / transcript evidence store
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
QDRANT_COLLECTION_NAME=earningwhisperer_evidence
QDRANT_TRANSCRIPT_COLLECTION_NAME=earningwhisperer_transcripts
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=512
EXTERNAL_EMBEDDING_PROVIDER=openai
EXTERNAL_EMBEDDING_MODEL=text-embedding-3-small
EXTERNAL_EMBEDDING_DIMENSION=512
EXTERNAL_EMBEDDING_VERSION=openai-text-embedding-3-small-512-v1
RAG_TOP_K=5
EXTERNAL_CHUNK_SIZE_CHARS=1200
EXTERNAL_CHUNK_OVERLAP_CHARS=160
FACT_CHECK_NEWS_LOOKBACK_DAYS=30
FACT_CHECK_TOP_K=8
FACT_CHECK_MAX_EVIDENCE=5
FACT_CHECK_STRONG_RELEVANCE_SCORE=0.42
FACT_CHECK_MODERATE_RELEVANCE_SCORE=0.34
FACT_CHECK_RETRIEVAL_TIMEOUT_SECONDS=3.0
FACT_CHECK_LLM_TIMEOUT_SECONDS=8.0
FACT_CHECK_MAX_OUTPUT_TOKENS=1024
FACT_CHECK_EXTRACTION_TIMEOUT_SECONDS=5.0
FACT_CHECK_EXTRACTION_MAX_OUTPUT_TOKENS=768
FACT_CHECK_MAX_CLAIMS_PER_SENTENCE=2
FACT_CHECK_MAX_CLAIMS_PER_BATCH=6
FACT_CHECK_SENTENCE_BUFFER_TTL_SECONDS=900
