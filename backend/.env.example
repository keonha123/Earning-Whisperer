# =============================================================================
# Backend 환경변수 템플릿
#
# 실제 값이 담긴 .env 는 커밋되지 않는다 (루트 .gitignore: .env, .env.*).
# 이 파일은 "어떤 키가 필요한가"만 기록한다. 값은 배포 대상 서버에서 채운다.
#
# 미설정 시 application.yml 의 기본값(로컬 개발용)이 적용된다.
# 아래 [필수] 표시 항목은 운영 배포에서 반드시 덮어써야 한다.
# =============================================================================

# ── Database (MySQL) ─────────────────────────────────────────────────────────
# data_pipeline 과 같은 DB(earning_whisperer)를 공유한다.
# ai-engine 은 별도 PostgreSQL 을 쓰므로 여기 해당 없음.
DB_URL=jdbc:mysql://localhost:3306/earning_whisperer?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────────────────────
# [필수] JWT_SECRET — 32자 이상 랜덤. 기본값을 그대로 쓰면 토큰 위조가 가능하다.
#        생성 예: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=earning-whisperer
JWT_AUDIENCE=earning-whisperer-api
# [필수] HTTPS 배포에서는 true. false 로 두면 쿠키가 평문 전송된다.
JWT_COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# [필수] 프론트엔드 출처. 쉼표 구분. 배포 시 Vercel 도메인으로 교체.
#        예: https://earning-whisperer.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── OAuth ────────────────────────────────────────────────────────────────────
# redirect URI 는 프론트엔드 콜백 주소다(백엔드가 아님).
# 아래 3곳의 값이 문자 단위로 일치해야 한다 —
#   1) 이 파일의 *_REDIRECT_URIS
#   2) Vercel 환경변수 NEXT_PUBLIC_*_REDIRECT_URI
#   3) 각 OAuth 콘솔의 승인된 리디렉션 URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=http://localhost:3000/auth/callback

# 카카오는 개인앱이라 이메일 권한이 없다. 콘솔에서 "플랫폼 > 사이트 도메인"도
# 함께 등록해야 하며, redirect URI 만 넣으면 인가 단계에서 막힌다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URIS=http://localhost:3000/auth/callback

# ── 내부 서비스 인증 ─────────────────────────────────────────────────────────
# [필수] data_pipeline / ai-engine 이 /api/v1/internal/** 호출 시 사용하는
#        X-Internal-Secret 헤더 값. 미설정이면 InternalSecretFilter 가
#        해당 경로를 전면 차단한다(fail-closed).
INTERNAL_SECRET=

# ── 외부 데이터 API ──────────────────────────────────────────────────────────
# 미설정 시 관련 기능만 비활성. 웹 데모 시연 경로에는 필요 없다.
FINNHUB_API_KEY=
FMP_API_KEY=

# ── 매매 ─────────────────────────────────────────────────────────────────────
# PENDING 상태 Trade 의 만료 시간(초).
TRADE_PENDING_TTL_SECONDS=30
