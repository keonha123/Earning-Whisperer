{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/lib/**/*", "src/test/**/*"],
  "compilerOptions": {
    "composite": true,
    "outDir": "dist/types/node",
    "types": ["electron-vite/node"],
    "paths": {
      "@main/*": ["./src/main/*"]
    }
  }
}
