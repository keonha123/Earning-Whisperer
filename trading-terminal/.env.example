# EarningWhisperer Trading Terminal — 로컬 환경변수 템플릿
#
# 사용법:
#   1. 본 파일을 `.env.local` 로 복사 (`.env.local` 은 git ignored)
#   2. 아래 값을 실제 client_id 로 교체
#   3. `npm run dev` 실행 — main process 가 자동 로딩
#
# 주의:
#   - client_id 는 OAuth 표준상 public 정보 (브라우저에 노출 OK)
#   - client_secret 은 백엔드만 보유. Electron 안에 절대 두지 마
#   - prod 빌드는 electron-vite 가 빌드 타임 inline 처리 (별도 PR)

# OAuth Provider client_id (Google / Kakao Developer Console 에서 발급)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_KAKAO_CLIENT_ID=

# 선택: 백엔드 URL (미설정 시 http://localhost:8082 fallback)
# BACKEND_URL=http://localhost:8082

# 선택: OAuth loopback 포트 (미설정 시 9000)
# OAUTH_LOOPBACK_PORT=9000
