[Unit]
Description=EarningWhisperer AI Engine (FastAPI)
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/earning-whisperer/ai-engine
EnvironmentFile=/opt/earning-whisperer/ai-engine.env
# 단일 워커. 실측 RSS 35MB — 임베딩을 Gemini 원격 호출로 하므로 로컬 모델이 없다.
ExecStart=/opt/earning-whisperer/ai-engine/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ew-ai-engine
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
