# =============================================================================
# Spring Boot 백엔드 systemd 유닛 (웹 데모 시연 배포용)
#
# 백엔드는 컨테이너가 아니라 jar 로 직접 실행한다. 이미지 빌드·푸시 시간을
# 아끼기 위한 선택이며, 대신 재시작·부팅 복구를 systemd 가 담당한다.
#
# 설치:
#   sudo cp infra/systemd/earning-whisperer-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now earning-whisperer-backend
#
# 로그:
#   journalctl -u earning-whisperer-backend -f
#
# 아래 경로는 배포 환경에 맞춰 수정할 것 (User, WorkingDirectory, jar 경로).
# =============================================================================

[Unit]
Description=EarningWhisperer Backend (Spring Boot)
# DB/Redis 컨테이너가 뜬 뒤 시작한다. docker.service 가 올라온 것과 컨테이너가
# ready 인 것은 다르므로, 기동 실패는 Restart 정책으로 흡수한다.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/earning-whisperer

# 시크릿은 이 파일에서만 읽는다. 저장소에 커밋하지 않으며 권한은 600.
#   sudo install -m 600 -o ubuntu backend/.env /opt/earning-whisperer/backend.env
EnvironmentFile=/opt/earning-whisperer/backend.env

ExecStart=/usr/bin/java -jar /opt/earning-whisperer/backend.jar

# DB 기동 지연이나 일시적 오류로 죽어도 계속 재시도한다.
# 시연 당일 서버가 조용히 내려가 있는 상황을 막는 것이 이 유닛의 존재 이유다.
Restart=always
RestartSec=10

# 무한 재시작 루프로 로그를 채우지 않도록 상한을 둔다.
StartLimitIntervalSec=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ew-backend

# 최소 권한 — 쓰기가 필요한 경로가 없다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
