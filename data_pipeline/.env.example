# Copy this file to data_pipeline/.env and fill in only the credentials needed
# by the deployment. Never commit data_pipeline/.env.

# Required for the live date-based watcher.
DB_URL=mysql+pymysql://user:password@db:3306/earning_whisperer

# Automatic live monitoring. The dispatcher starts immediately after scheduler
# startup and runs every one minute; long browser probes run in separate tasks.
ENABLE_DATE_STREAM_WATCH=true
DATE_STREAM_AUTO_CAPTURE_ENABLED=true
WEBCAST_CAPTURE_RUNNER=container
# Live mode must positively match the scheduled date beside earnings/call
# context before a generic IR page can hand a player to audio capture.
WEBCAST_REQUIRE_LIVE_TARGET_CONFIRMATION=true
DB_POOL_RECYCLE_SECONDS=1800
# MySQL pool/socket waits are bounded separately; connect timeout does not
# protect a connection that stops replying after a query or COMMIT.
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READ_TIMEOUT_SECONDS=5
DB_WRITE_TIMEOUT_SECONDS=5
DATE_STREAM_DB_OUTAGE_LOG_INTERVAL_SECONDS=300
# Kept for backwards compatibility. Live scheduler cadence is fixed at 1 minute.
DATE_STREAM_WATCH_INTERVAL_MINUTES=1
DATE_STREAM_WATCH_DAYS_AHEAD=2
DATE_STREAM_WATCH_BATCH_SIZE=10
# Raise this to 2 when one slot should keep scanning while another runs a long probe.
DATE_STREAM_WATCH_CONCURRENCY=1
ENABLE_STT_MONITOR=false
SCHEDULER_TIMEZONE=Asia/Seoul
ENABLE_FINNHUB_NEWS_JOB=true
# Date-only events are revisited once a minute; DB ordering rotates through
# least-recently-probed calls so one pending site cannot starve the rest.
DATE_STREAM_WATCH_COOLDOWN_MINUTES=1
DATE_STREAM_FUTURE_DATE_INTERVAL_MINUTES=60
DATE_STREAM_STALE_DATE_INTERVAL_MINUTES=180
DATE_STREAM_LOW_PRIORITY_PROBE_TIMEOUT_SECONDS=90
DATE_STREAM_CAPTURE_HEARTBEAT_SECONDS=30
# Keep the verified browser/PulseAudio session alive and promote that same
# process into STT capture instead of reopening the provider page.
WEBCAST_PROBE_PROMOTION_ENABLED=true
WEBCAST_PROBE_PROMOTION_TIMEOUT_SECONDS=90
STT_COMPLETION_MIN_SEGMENTS=2
STT_COMPLETION_MIN_CHARACTERS=80
DATE_STREAM_DATE_ONLY_RETRY_MINUTES=1
DATE_STREAM_AUDIO_WAIT_SECONDS=90
# One detailed probe can spend 180s activating a player and then exercise
# normal/direct-media/YouTube audio routes. Its supervisor must outlive them.
WEBCAST_PLAYBACK_READY_TIMEOUT_SECONDS=180
DATE_STREAM_PROBE_TIMEOUT_SECONDS=540
DATE_STREAM_CALL_PROBE_TIMEOUT_SECONDS=600
DATE_STREAM_PROBE_TERMINATE_GRACE_SECONDS=10
DATE_STREAM_PROBE_KILL_GRACE_SECONDS=5
DATE_STREAM_EARLY_ENTRY_MINUTES=5
DATE_STREAM_NEAR_START_MINUTES=20
DATE_STREAM_NEAR_END_MINUTES=180
DATE_STREAM_NEAR_INTERVAL_MINUTES=1
# Try a bounded number of shared-engine entrypoints/candidates per watch cycle.
DATE_STREAM_CANDIDATE_ATTEMPTS=3
DATE_STREAM_CANDIDATE_RETRY_DELAY_SECONDS=1
DATE_STREAM_PROBE_LEASE_MINUTES=10
DATE_STREAM_CAPTURE_LEASE_MINUTES=120
# 0 means retry a failed capture until the call naturally leaves its watch window.
DATE_STREAM_CAPTURE_MAX_ATTEMPTS=0
# After speech was heard, repeated speech-idle failures require operator review.
# This cap does not stop an active capture or limit pre-start browser polling.
DATE_STREAM_IDLE_CAPTURE_MAX_ATTEMPTS=3
# Live source loss or an incomplete safety-limit exit reconnects on this
# shorter cadence while the event is still inside its watch window.
DATE_STREAM_CAPTURE_CONTINUATION_RETRY_MINUTES=1
# Transient browser/audio failures back off 3, 6, 12 ... minutes (capped), so
# one fragile provider cannot repeatedly resubmit its registration form.
DATE_STREAM_CAPTURE_RETRY_MINUTES=3
DATE_STREAM_CAPTURE_RETRY_BACKOFF_MULTIPLIER=2
DATE_STREAM_CAPTURE_MAX_RETRY_MINUTES=60
DATE_STREAM_CAPTURE_AUTH_RETRY_MINUTES=720
DATE_STREAM_CAPTURE_AUTH_MAX_ATTEMPTS=1
DATE_STREAM_CAPTURE_BLOCKED_RETRY_MINUTES=360
DATE_STREAM_CAPTURE_BLOCKED_MAX_ATTEMPTS=1
DATE_STREAM_SCHEDULE_MISMATCH_RETRY_MINUTES=60
# Do not repeatedly hit providers that explicitly reject automation or need a
# human/authorized login. Near an already verified live start, ordinary "not
# live yet" candidate checks remain on the one-minute cadence.
DATE_STREAM_BLOCKED_RETRY_MINUTES=360
DATE_STREAM_AUTH_RETRY_MINUTES=720
DATE_STREAM_AUTH_NEAR_LIVE_RETRY_MINUTES=1
DATE_STREAM_NO_CANDIDATE_RETRY_MINUTES=15
DATE_STREAM_TRANSIENT_RETRY_MINUTES=5
DATE_STREAM_NEAR_LIVE_RETRY_MINUTES=1
DATE_STREAM_SCHEDULE_REFRESH_COOLDOWN_MINUTES=60
DATE_STREAM_STALE_LEASE_MINUTES=20
DATE_STREAM_RECOVERY_INTERVAL_SECONDS=60
PIPELINE_WORKER_ID=
# Yahoo Finance supplies broad dates. Exact start times are rechecked from
# issuer-owned pages first, then optional Serper discovery when necessary.
LIVE_SCHEDULE_REFRESH_ON_STARTUP=true
LIVE_SCHEDULE_REFRESH_WORKERS=10
# Retry only database connection failures after a restart. Delays are linear:
# 15, 30, 45 ... seconds, so MySQL healthcheck startup does not lose the refresh.
SCHEDULE_STARTUP_REFRESH_MAX_ATTEMPTS=6
SCHEDULE_STARTUP_REFRESH_RETRY_SECONDS=15
# Compare near-term Yahoo rows with Nasdaq once per broad refresh. Third-party
# disagreements remain watchable with a wider date window until issuer IR wins.
SCHEDULE_NASDAQ_RECONCILIATION_ENABLED=true
SCHEDULE_RECONCILIATION_DAYS_AHEAD=14
SCHEDULE_NASDAQ_TIMEOUT_SECONDS=15
# Provisional dates are watched on both sides of the reported calendar date.
DATE_STREAM_UNCERTAIN_DATE_GRACE_DAYS=2
# A nearby issuer call date may legitimately differ from the release date.
OFFICIAL_EVENT_DATE_GRACE_DAYS=2
# Official IR event links and provider URLs are refreshed hourly by the same
# bounded enrichment job that verifies exact start times.
SCHEDULE_TIME_REFRESH_INTERVAL_MINUTES=10
SCHEDULE_TIME_REFRESH_LIMIT=20
SCHEDULE_TIME_REVERIFY_DAYS_AHEAD=14
SCHEDULE_TIME_REVERIFY_HOURS=24
# Schedule-time enrichment stores a per-call negative cache. These cooldowns
# do not remove a call from the date-based live watcher.
SCHEDULE_ENRICH_NO_TIME_RETRY_MINUTES=60
SCHEDULE_ENRICH_ISSUER_TIMEOUT_RETRY_MINUTES=60
SCHEDULE_ENRICH_ISSUER_ERROR_RETRY_MINUTES=60
SCHEDULE_ENRICH_ISSUER_ACCESS_RETRY_MINUTES=360
# A provider-wide circuit prevents repeated paid Serper requests after a key,
# credit, rate-limit, or malformed-request failure. It is persisted in MySQL.
SCHEDULE_ENRICH_SERPER_CREDITS_COOLDOWN_MINUTES=720
SCHEDULE_ENRICH_SERPER_KEY_COOLDOWN_MINUTES=1440
SCHEDULE_ENRICH_SERPER_RATE_LIMIT_COOLDOWN_MINUTES=60
SCHEDULE_ENRICH_SERPER_REQUEST_ERROR_COOLDOWN_MINUTES=60
SCHEDULE_ENRICH_SERPER_TRANSIENT_RETRY_MINUTES=15
SCHEDULE_ENRICH_SERPER_UNCONFIGURED_RETRY_MINUTES=720
SCHEDULE_ENRICH_SERPER_CIRCUIT_RETRY_MINUTES=60
# Bounded internal IR replay discovery for candidate_retry/no_training_surface.
IR_CRAWL_MAX_DEPTH=3
IR_CRAWL_MAX_PAGES=10
IR_CRAWL_CANDIDATES_PER_CALL=5
IR_STORED_REPLAY_CANDIDATES=5
IR_CRAWL_TIMEOUT_SECONDS=8

# External discovery and webcast registration. Leave blank when unused.
SERPER_API_KEY=
WEBCAST_EMAIL=
WEBCAST_PASSWORD=
WEBCAST_FIRST_NAME=Private
WEBCAST_LAST_NAME=Investor
WEBCAST_COMPANY=EarningWhisperer
WEBCAST_PHONE=
WEBCAST_INDUSTRY_AFFILIATION=Other
WEBCAST_ATTENDEE_TYPE=Other
WEBCAST_OTHER_OPTION=Other
# Normal webcast capture automatically submits the configured attendee profile.
# Preview and discovery modes never submit, even with these settings enabled.
WEBCAST_ALLOW_REGISTRATION_SUBMISSION=true
# Set true to require a ticker/destination approval manifest before form POSTs.
WEBCAST_REGISTRATION_REQUIRE_APPROVAL=false
# Registration may open a new tab and wait for a provider-side redirect.
WEBCAST_REGISTRATION_TIMEOUT_SECONDS=120
WEBCAST_REGISTRATION_POST_SUBMIT_WAIT_SECONDS=30
# Retry a stored/provider replay URL once when the first navigation leaves a
# blank page. Keep this bounded so a blocked host does not hold a worker.
WEBCAST_DIRECT_TARGET_RETRIES=2
WEBCAST_DIRECT_TARGET_RETRY_DELAY_SECONDS=1
# Direct event-detail pages often load more slowly than their IR archive.
WEBCAST_DIRECT_TARGET_NAVIGATION_TIMEOUT_SECONDS=30
# Retry player activation on the same page while late iframes/controls mount.
WEBCAST_PLAYBACK_RETRY_INTERVAL_SECONDS=5
# MetaMeetings privacy page: when enabled, submit the current choice without
# changing it; if no choice is selected, select Opt out rather than Opt in.
# Leave blank to follow WEBCAST_ALLOW_REGISTRATION_SUBMISSION.
WEBCAST_ALLOW_PRIVACY_CONSENT_SUBMISSION=

# Optional Q4 profile. Keep disabled until an authorized account is available.
Q4_EMAIL=
Q4_PASSWORD=
Q4_FIRST_NAME=
Q4_LAST_NAME=

# STT and transcript retention.
STT_MODEL_NAME=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
# Safety ceiling for live captures, independent of browser hold duration.
# Hitting this ceiling is INCOMPLETE and may retry; it never proves event end.
# Supervised live browsers stay open until the worker/supervisor ends them.
# Replay/manual browser --hold-seconds continues to work as before.
STT_MAX_SESSION_SECONDS=14400
STT_NO_CHUNK_TIMEOUT_SECONDS=45
# Allow the verified stream's pre-call music/intro without spending the
# after-speech idle budget. Both timeouts mark live runs incomplete.
STT_INITIAL_SPEECH_TIMEOUT_SECONDS=3600
STT_NO_TEXT_TIMEOUT_SECONDS=600
# Live speech-idle timing begins after distinct adjacent speech windows;
# uncertain/model music text is preserved without shortening the initial wait.
# After a verified end/source-loss signal, bound the recorder's stop delay.
# Once recording has stopped, the remaining STT backlog has no drain deadline.
STT_LIVE_DRAIN_TIMEOUT_SECONDS=30
# Require a visible, current-event end notice to persist before ending capture.
# These values do not turn a stalled media clock or background music into EOF.
WEBCAST_LIVE_END_POLL_SECONDS=2
WEBCAST_LIVE_END_CONFIRM_SECONDS=10
# Whisper receives a 20-second rolling window with 2 seconds of overlap. This
# is long enough for sentence context while exact overlap text is deduplicated.
STT_READ_BYTES=640000
STT_OVERLAP_BYTES=64000
STT_READS_PER_EMIT=1
# Drain FFmpeg independently while Whisper runs. The bounded queue retains up
# to three minutes of mono PCM; overflow makes the capture retry instead of
# silently accepting a transcript with a missing interval.
STT_AUDIO_READER_CHUNK_BYTES=32000
STT_AUDIO_QUEUE_SECONDS=180
# Capture a short non-persistent WAV after browser audio is detected. The
# worker records only waveform/VAD counts in a JSON report beside the capture
# artifact, then deletes the WAV unless explicitly retained for diagnosis.
STT_AUDIO_PREFLIGHT_SECONDS=12
# Record short speech-readiness evidence after the player/audio route is open.
# A silent intro remains a valid webcast and the long capture keeps observing
# it; this compact tiny-model check therefore never discards the candidate.
WEBCAST_SPEECH_PREFLIGHT_ENABLED=true
STT_AUDIO_PREFLIGHT_MODEL_NAME=tiny
STT_AUDIO_PREFLIGHT_REQUIRED=false
STT_AUDIO_PREFLIGHT_KEEP=false
TRANSCRIPT_ARCHIVE_ENABLED=true
TRANSCRIPT_RETENTION_DAYS=180
TRANSCRIPT_PURGE_BATCH_SIZE=10000
TRANSCRIPT_PURGE_MAX_BATCHES=10
TRANSCRIPT_OUTBOX_RETRY_INTERVAL_SECONDS=30
TRANSCRIPT_OUTBOX_RETRY_BATCH_SIZE=50
# Leave blank to use data_pipeline/.runtime/transcript-archive-spool.jsonl,
# a Docker-mounted write-ahead spool for transcript segments and terminal markers.
TRANSCRIPT_ARCHIVE_SPOOL_PATH=
# Each replay drains a bounded snapshot without holding the spool writers' lock
# during DB I/O.
TRANSCRIPT_ARCHIVE_REPLAY_LIMIT=100
STT_OUTBOX_SPOOL_PATH=/tmp/earning-whisperer-transcript-outbox.jsonl
STOCK_PRICE_SYNC_MAX_TICKERS=0
WEBCAST_ARTIFACT_RETENTION_DAYS=14
WEBCAST_ARTIFACT_MAX_GROUPS=2000
OPERATIONS_LOG_RETENTION_DAYS=30
OPERATIONS_LOG_MAX_FILES=2000
OPERATIONS_ALERT_INTERVAL_SECONDS=300
OPERATIONS_ALERT_COOLDOWN_SECONDS=1800
OPERATIONS_ALERT_STALE_COUNT=1
OPERATIONS_ALERT_OUTBOX_COUNT=10
OPERATIONS_ALERT_BLOCKED_SITE_COUNT=3
# Optional JSON webhook. When blank, alerts remain in the operations log/state file.
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_STATE_FILE=
OPERATIONS_ALERT_TIMEOUT_SECONDS=5
# Optional evidence directory. If unset, a user-writable runtime fallback is used
# when the legacy Docker artifact directory is not writable.
# WEBCAST_ARTIFACTS_DIR=

# Optional downstream services.
SEND_TO_AI_ENGINE=false
SEND_TO_BACKEND=false
AI_ENGINE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8082
INTERNAL_SECRET=

# Optional screenshot-based candidate selection. DOM heuristics work without it.
WEBCAST_VISION_ENABLED=false
OPENAI_API_KEY=
WEBCAST_VISION_MODEL=gpt-5.6-luna
WEBCAST_VISION_MIN_CONFIDENCE=0.55

# Live acquisition: discovery uses a separate, bounded browser budget.
DATE_STREAM_DISCOVERY_ENABLED=true
DATE_STREAM_DISCOVERY_CONCURRENCY=2
DATE_STREAM_DISCOVERY_TIMEOUT_SECONDS=45
# Unset DATE_STREAM_DISCOVERY_HEADED to inherit WEBCAST_HEADED (default true).
# DATE_STREAM_DISCOVERY_HEADED=true
# Unset capture concurrency to retain DATE_STREAM_WATCH_CONCURRENCY as its limit.
# DATE_STREAM_CAPTURE_CONCURRENCY=1
# Three-call local deployment: use infra/docker-compose.concurrent.yml.
# It sets capture/discovery limits to 3 and STT_CPU_THREADS=2 with an 8-CPU,
# 10-GiB container budget. Validate your host before using that profile elsewhere.
# One scheduler only: capacity reservations are not distributed between replicas.
DATE_STREAM_WATCH_MAX_GAP_MINUTES=10
SCHEDULE_TIME_NEAR_REVERIFY_MINUTES=10
# Older exact starts remain evidence, but no longer narrow live discovery.
SCHEDULE_TIME_LIVE_MAX_AGE_MINUTES=120
# Retry missing official times more frequently for today's/tomorrow's calls.
SCHEDULE_ENRICH_NEAR_NO_TIME_RETRY_MINUTES=10
WEBCAST_LIVE_NAVIGATION_STEPS=4
WEBCAST_TARGET_PROOF_TTL_SECONDS=21600
# Preserve playback-ready -> preflight -> STT audio in a private temporary file.
STT_PCM_HANDOFF_ENABLED=true
STT_PCM_HANDOFF_MAX_BYTES=536870912
# Nearby exact-time lookup: HTTP first, bounded browser fallback.
SCHEDULE_TIME_BROWSER_DAYS_AHEAD=2
SCHEDULE_TIME_BROWSER_PAGES_PER_CALL=2
SCHEDULE_TIME_BROWSER_SECONDS_PER_CALL=60
SCHEDULE_TIME_BROWSER_PAGES_PER_REFRESH=6
SCHEDULE_TIME_BROWSER_SECONDS_PER_REFRESH=120
SCHEDULE_TIME_BROWSER_PAGE_TIMEOUT_SECONDS=35

# Abandoned PCM is preserved separately after verifying no active owner/consumer.
# This does not increase the active-recording budget (default 2 GiB).
STT_AUDIO_RESCUE_TOTAL_MAX_BYTES=2147483648
STT_AUDIO_RESCUE_RETENTION_SECONDS=172800
STT_AUDIO_RESCUE_QUARANTINE_MAX_BYTES=8589934592
STT_AUDIO_RESCUE_QUARANTINE_RETENTION_SECONDS=604800
