# Copy this file to data_pipeline/.env and fill in only the credentials needed
# by the deployment. Never commit data_pipeline/.env.

# Required for the live date-based watcher.
DB_URL=mysql+pymysql://user:password@db:3306/earning_whisperer
ENABLE_DATE_STREAM_WATCH=true
DATE_STREAM_AUTO_CAPTURE_ENABLED=true
WEBCAST_CAPTURE_RUNNER=container
DATE_STREAM_WATCH_BATCH_SIZE=500
DATE_STREAM_WATCH_INTERVAL_MINUTES=10
DATE_STREAM_WATCH_DAYS_AHEAD=2
DATE_STREAM_WATCH_CONCURRENCY=4
DATE_STREAM_WATCH_COOLDOWN_MINUTES=15
DATE_STREAM_AUDIO_WAIT_SECONDS=90
DATE_STREAM_PROBE_TIMEOUT_SECONDS=120
DATE_STREAM_NEAR_START_MINUTES=20
DATE_STREAM_NEAR_END_MINUTES=180
DATE_STREAM_NEAR_INTERVAL_MINUTES=1

# External discovery and webcast registration. Leave blank when unused.
SERPER_API_KEY=
WEBCAST_EMAIL=
WEBCAST_PASSWORD=
WEBCAST_FIRST_NAME=Private
WEBCAST_LAST_NAME=Investor
WEBCAST_COMPANY=EarningWhisperer
WEBCAST_INDUSTRY_AFFILIATION=Other
WEBCAST_ALLOW_REGISTRATION_SUBMISSION=false

# Optional Q4 profile. Keep disabled until an authorized account is available.
Q4_EMAIL=
Q4_PASSWORD=
Q4_FIRST_NAME=
Q4_LAST_NAME=

# STT and transcript retention.
STT_MODEL_NAME=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
TRANSCRIPT_ARCHIVE_ENABLED=true
TRANSCRIPT_RETENTION_DAYS=180
TRANSCRIPT_PURGE_BATCH_SIZE=10000
TRANSCRIPT_PURGE_MAX_BATCHES=10
WEBCAST_ARTIFACT_RETENTION_DAYS=14
WEBCAST_ARTIFACT_MAX_GROUPS=2000

# Optional downstream services.
SEND_TO_AI_ENGINE=false
SEND_TO_BACKEND=false
AI_ENGINE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8082
INTERNAL_SECRET=

# Optional screenshot-based candidate selection. DOM heuristics work without it.
WEBCAST_VISION_ENABLED=false
OPENAI_API_KEY=
WEBCAST_VISION_MODEL=gpt-5.6-luna
WEBCAST_VISION_MIN_CONFIDENCE=0.55
